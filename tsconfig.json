{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "outDir": "dist",
        "rootDir": ".",
        "strict": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowJs": true,
        "resolveJsonModule": true,
        "declaration": false,
        "sourceMap": false
    },
    "include": [
        "api/**/*.ts",
        "api/**/*.js",
        "core/**/*.ts",
        "services/**/*.ts",
        "repositories/**/*.ts",
        "clients/**/*.ts",
        "shared/**/*.ts",
        "errors/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "public",
        "dist",
        "**/*.backup"
    ]
}
