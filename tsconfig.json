{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "lib": ["ES2020"],
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowJs": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "outDir": "./dist"
    },
    "include": ["api/**/*.ts", "core/**/*.ts", "services/**/*.ts", "repositories/**/*.ts", "middleware/**/*.ts"],
    "exclude": ["node_modules", "app", "tests"]
}
