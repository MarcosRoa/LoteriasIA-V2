{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "lib": ["ES2020"],
        "strict": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowJs": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "isolatedModules": true
    },
    "include": [
        "api/**/*.ts",
        "core/**/*.ts",
        "services/**/*.ts",
        "repositories/**/*.ts",
        "middleware/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
